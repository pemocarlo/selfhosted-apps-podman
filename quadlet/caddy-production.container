[Unit]
Description=Caddy static site - production

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=caddy-static
EnvironmentFile=%h/caddy-static/caddy.env
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp
Network=caddy-public.network
Volume=%h/caddy-static/Caddyfile:/etc/caddy/Caddyfile:Z,ro
Volume=%h/caddy-static/conf.d:/etc/caddy/conf.d:Z,ro
Volume=%h/caddy-static/site:/srv:Z,ro
Volume=%h/caddy-static/data:/data:Z
Volume=%h/caddy-static/config:/config:Z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
