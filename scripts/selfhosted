#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
STATE="${SELFHOSTED_ROOT:-$HOME/selfhosted}"
QUADLETS="${QUADLET_DIR:-$HOME/.config/containers/systemd}"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

require_commands() {
  local name
  for name; do command -v "$name" >/dev/null || die "$name is required"; done
}

usage() {
  cat <<'EOF'
Usage: scripts/selfhosted COMMAND [TARGET]

  deploy gateway [local|production]
  deploy NAME                         install or re-deploy one app
  deploy app NAME                     same as "deploy NAME"
  deploy all [local|production]
  add NAME                            install a new app
  enable NAME                         re-enable a disabled/removed app
  restart NAME|gateway|all            restart without pulling images
  update NAME|gateway|all
  disable NAME                        temporarily stop; preserve data
  remove NAME                         uninstall app units; preserve data
  status [NAME|gateway|all]
  logs NAME|gateway [--follow]
  list                                show available apps and their state
  check                               validate host, Quadlets, and Caddy
EOF
}

apps() {
  local path
  for path in "$ROOT"/services/*; do
    [[ -d "$path/quadlet" ]] && basename "$path"
  done
}

app_source() {
  [[ "${1:-}" =~ ^[a-z0-9][a-z0-9-]*$ && -d "$ROOT/services/$1/quadlet" ]] ||
    die "unknown app '${1:-}'; run 'scripts/selfhosted list'"
  printf '%s\n' "$ROOT/services/$1"
}

app_installed() {
  local source file
  source="$(app_source "$1")"
  [[ -s "$STATE/services/$1/.installed-quadlets" ]] && return 0
  for file in "$source"/quadlet/*; do
    [[ -f "$file" && -f "$QUADLETS/$(basename "$file")" ]] && return 0
  done
  return 1
}

app_fully_installed() {
  local source file found=false
  source="$(app_source "$1")"
  for file in "$source"/quadlet/*; do
    [[ -f "$file" ]] || continue
    found=true
    [[ -f "$QUADLETS/$(basename "$file")" ]] || return 1
  done
  [[ "$found" == true ]]
}

list_apps() {
  local app state
  printf '%-20s %s\n' APP STATE
  while read -r app; do
    if [[ -e "$STATE/services/$app/.disabled" ]]; then
      state=disabled
    elif app_fully_installed "$app"; then
      state=installed
    elif app_installed "$app"; then
      state=needs-deploy
    elif [[ -d "$STATE/services/$app" ]]; then
      state=configured
    else
      state=available
    fi
    printf '%-20s %s\n' "$app" "$state"
  done < <(apps)
}

units() {
  local file
  for file in "$1"/quadlet/*.container; do
    [[ -f "$file" ]] && printf '%s.service\n' "$(basename "$file" .container)"
  done
}

install_templates() {
  local source="$1" target="$2" template name destination
  mkdir -p "$target"
  for template in "$source"/*.example.env "$source"/*.env.example "$source"/*.example.conf; do
    [[ -f "$template" ]] || continue
    name="$(basename "$template")"
    if [[ "$name" == *.example.env ]]; then
      name="${name%.example.env}.env"
    elif [[ "$name" == *.env.example ]]; then
      name="${name%.env.example}.env"
    else
      name="${name%.example.conf}.conf"
    fi
    destination="$target/$name"
    [[ -e "$destination" ]] || {
      install -m 0600 "$template" "$destination"
      printf 'created %s; edit it and deploy again if it contains placeholders\n' "$destination"
    }
  done
}

sync_managed_files() {
  local source="$1" target="$2" manifest="$3" pending="$3.new" file name
  mkdir -p "$target"
  if [[ -f "$manifest" ]]; then
    while read -r name; do
      [[ "$name" =~ ^[A-Za-z0-9_.@-]+$ ]] || continue
      [[ -f "$source/$name" ]] || rm -f "$target/$name"
    done < "$manifest"
  fi
  : > "$pending"
  chmod 0600 "$pending"
  while IFS= read -r -d '' file; do
    name="$(basename "$file")"
    cp -a "$file" "$target/$name"
    printf '%s\n' "$name" >> "$pending"
  done < <(find "$source" -maxdepth 1 -type f -print0)
  mv -f "$pending" "$manifest"
}

install_seed_files() {
  local source="$1" target="$2" path name
  mkdir -p "$target"
  while IFS= read -r -d '' path; do
    name="$(basename "$path")"
    [[ -e "$target/$name" ]] || cp -a "$path" "$target/$name"
  done < <(find "$source" -mindepth 1 -maxdepth 1 ! -name .gitkeep -print0)
}

reject_placeholders() {
  grep -qs CHANGE_ME "$1"/*.env "$1"/*.conf 2>/dev/null &&
    die "replace CHANGE_ME in $1 configuration, then deploy again"
  return 0
}

install_quadlets() {
  local source="$1" manifest="$2" pending="$2.new" file name
  mkdir -p "$QUADLETS"
  if [[ -f "$manifest" ]]; then
    while read -r name; do
      [[ "$name" =~ ^[A-Za-z0-9_.@-]+$ ]] || continue
      [[ -f "$source/quadlet/$name" ]] || rm -f "$QUADLETS/$name"
    done < "$manifest"
  fi
  : > "$pending"
  chmod 0600 "$pending"
  for file in "$source"/quadlet/*; do
    [[ -f "$file" ]] || continue
    name="$(basename "$file")"
    install -m 0644 "$file" "$QUADLETS/$name"
    printf '%s\n' "$name" >> "$pending"
  done
  mv -f "$pending" "$manifest"
}

prepare_app() {
  local app="$1" source target path
  source="$(app_source "$app")"
  target="$STATE/services/$app"
  install_templates "$source" "$target"
  for path in "$source"/*; do
    [[ -d "$path" && "$(basename "$path")" != quadlet ]] || continue
    install_seed_files "$path" "$target/$(basename "$path")"
  done
  reject_placeholders "$target"
}

validate_caddy() {
  podman run --rm --env-file "$2" \
    -v "$1/Caddyfile:/etc/caddy/Caddyfile:ro,Z" \
    -v "$1/conf.d:/etc/caddy/conf.d:ro,Z" \
    docker.io/library/caddy:2.11.4-alpine \
    caddy validate --config /etc/caddy/Caddyfile
}

validate_quadlets() {
  local generator path paths="$ROOT/gateway/quadlet"
  for path in "$ROOT"/services/*/quadlet; do
    [[ -d "$path" ]] && paths+=":$path"
  done
  for generator in /usr/lib/systemd/system-generators/podman-system-generator \
    /usr/libexec/podman/quadlet; do
    [[ -x "$generator" ]] || continue
    QUADLET_UNIT_DIRS="$paths" "$generator" --user --dryrun >/dev/null
    printf 'Quadlet definitions passed generator validation\n'
    return
  done
  printf 'warning: Podman Quadlet generator not found; skipped Quadlet validation\n' >&2
}

deploy_gateway() {
  local profile="${1:-production}" source="$ROOT/gateway" target="$STATE/gateway"
  [[ "$profile" == local || "$profile" == production ]] || die 'profile must be local or production'
  mkdir -p "$target"/{conf.d,site,data,config} "$QUADLETS"
  install -m 0644 "$source/Caddyfile" "$target/Caddyfile"
  sync_managed_files "$source/conf.d" "$target/conf.d" "$target/.installed-conf-files"
  sync_managed_files "$source/site" "$target/site" "$target/.installed-site-files"
  cp -a "$source/site/." "$target/site/"
  install_templates "$source" "$target"
  reject_placeholders "$target"
  validate_caddy "$target" "$target/caddy.env"
  install -m 0644 "$source/quadlet/caddy-public.network" "$QUADLETS/caddy-public.network"
  install -m 0644 "$source/quadlet/caddy-$profile.container" "$QUADLETS/caddy-static.container"
  systemctl --user daemon-reload
  systemctl --user restart caddy-static.service
  printf 'deployed gateway (%s)\n' "$profile"
}

deploy_app() {
  local app="$1" source unit_list
  source="$(app_source "$app")"
  if grep -Rqs '^Network=caddy-public\.network$' "$source/quadlet" &&
    [[ ! -f "$QUADLETS/caddy-public.network" ]]; then
    die "the gateway network is not installed; run 'scripts/selfhosted deploy gateway local' first"
  fi
  prepare_app "$app"
  rm -f "$STATE/services/$app/.disabled"
  install_quadlets "$source" "$STATE/services/$app/.installed-quadlets"
  systemctl --user daemon-reload
  unit_list="$(units "$source")"
  [[ -z "$unit_list" ]] || systemctl --user restart $unit_list
  systemctl --user try-restart caddy-static.service
  printf 'deployed %s\n' "$app"
}

deploy_all() {
  local app
  deploy_gateway "${1:-production}"
  while read -r app; do
    if [[ -e "$STATE/services/$app/.disabled" ]]; then
      printf 'skip disabled %s\n' "$app"
    elif ! app_installed "$app"; then
      printf 'skip uninstalled %s\n' "$app"
    else
      deploy_app "$app"
    fi
  done < <(apps)
}

pull_images() {
  local image
  while read -r image; do
    [[ -z "$image" ]] || [[ "$image" == localhost/* ]] || podman pull "$image"
  done < <(sed -n 's/^Image=//p' "$1"/quadlet/*.container | sort -u)
}

update() {
  local target="$1" app source
  if [[ "$target" == all ]]; then
    if [[ -f "$QUADLETS/caddy-static.container" ]]; then
      update gateway
    else
      printf 'skip uninstalled gateway\n'
    fi
    while read -r app; do
      if app_fully_installed "$app" && [[ ! -e "$STATE/services/$app/.disabled" ]]; then
        update "$app"
      fi
    done < <(apps)
  elif [[ "$target" == gateway ]]; then
    [[ -f "$QUADLETS/caddy-static.container" ]] ||
      die "gateway is not installed; run 'scripts/selfhosted deploy gateway local' first"
    pull_images "$ROOT/gateway"
    systemctl --user restart caddy-static.service
  else
    source="$(app_source "$target")"
    [[ ! -e "$STATE/services/$target/.disabled" ]] || die "$target is disabled"
    app_fully_installed "$target" ||
      die "$target is not fully installed; run 'scripts/selfhosted deploy $target' first"
    pull_images "$source"
    local unit_list
    unit_list="$(units "$source")"
    [[ -z "$unit_list" ]] || systemctl --user restart $unit_list
  fi
}

uninstall_app() {
  local app="$1" source file name unit_list manifest
  source="$(app_source "$app")"
  unit_list="$(units "$source")"
  [[ -z "$unit_list" ]] || systemctl --user stop $unit_list || true
  manifest="$STATE/services/$app/.installed-quadlets"
  if [[ -f "$manifest" ]]; then
    while read -r name; do
      [[ "$name" =~ ^[A-Za-z0-9_.@-]+$ ]] || continue
      if [[ "$name" == *.container ]]; then
        systemctl --user stop "${name%.container}.service" || true
      fi
      rm -f "$QUADLETS/$name"
    done < "$manifest"
  fi
  for file in "$source"/quadlet/*; do
    [[ -f "$file" ]] && rm -f "$QUADLETS/$(basename "$file")"
  done
  systemctl --user daemon-reload
}

disable() {
  local app="$1"
  app_source "$app" >/dev/null
  mkdir -p "$STATE/services/$app"
  touch "$STATE/services/$app/.disabled"
  uninstall_app "$app"
  printf 'disabled %s; data preserved\n' "$app"
}

remove_app() {
  local app="$1" manifest="$STATE/services/$1/.installed-quadlets"
  app_source "$app" >/dev/null
  uninstall_app "$app"
  rm -f "$STATE/services/$app/.disabled" "$manifest" "$manifest.new"
  printf 'removed %s service definitions; configuration and data preserved\n' "$app"
}

restart_target() {
  local target="$1" app source unit_list
  if [[ "$target" == all ]]; then
    [[ ! -f "$QUADLETS/caddy-static.container" ]] || restart_target gateway
    while read -r app; do
      if app_fully_installed "$app" && [[ ! -e "$STATE/services/$app/.disabled" ]]; then
        restart_target "$app"
      fi
    done < <(apps)
  elif [[ "$target" == gateway ]]; then
    [[ -f "$QUADLETS/caddy-static.container" ]] || die 'gateway is not installed'
    systemctl --user restart caddy-static.service
    printf 'restarted gateway\n'
  else
    source="$(app_source "$target")"
    [[ ! -e "$STATE/services/$target/.disabled" ]] || die "$target is disabled"
    app_fully_installed "$target" || die "$target is not fully installed; deploy it first"
    unit_list="$(units "$source")"
    [[ -z "$unit_list" ]] || systemctl --user restart $unit_list
    printf 'restarted %s\n' "$target"
  fi
}

status() {
  local target="${1:-all}" app source unit_list
  if [[ "$target" == all ]]; then
    status gateway
    while read -r app; do status "$app"; done < <(apps)
  elif [[ "$target" == gateway ]]; then
    [[ -f "$QUADLETS/caddy-static.container" ]] || { printf 'gateway: not installed\n'; return; }
    systemctl --user --no-pager --full status caddy-static.service || true
  else
    source="$(app_source "$target")"
    [[ ! -e "$STATE/services/$target/.disabled" ]] || { printf '%s: disabled\n' "$target"; return; }
    app_fully_installed "$target" || { printf '%s: not fully installed; deploy it first\n' "$target"; return; }
    unit_list="$(units "$source")"
    [[ -z "$unit_list" ]] || systemctl --user --no-pager --full status $unit_list || true
  fi
}

logs() {
  local target="$1" follow="${2:-}" source unit
  local -a args=(--user --no-pager -n "${SELFHOSTED_LOG_LINES:-100}")
  [[ -z "$follow" || "$follow" == --follow ]] || die 'logs accepts only --follow'
  [[ "$follow" == --follow ]] && args+=(-f)
  if [[ "$target" == gateway ]]; then
    [[ -f "$QUADLETS/caddy-static.container" ]] || die 'gateway is not installed'
    args+=(-u caddy-static.service)
  else
    source="$(app_source "$target")"
    [[ ! -e "$STATE/services/$target/.disabled" ]] || die "$target is disabled"
    app_fully_installed "$target" || die "$target is not fully installed; deploy it first"
    while read -r unit; do args+=(-u "$unit"); done < <(units "$source")
  fi
  journalctl "${args[@]}"
}

check() {
  [[ "$(podman info --format '{{.Host.CgroupsVersion}}')" == v2 ]] || die 'Quadlet requires cgroup v2'
  systemctl --user show-environment >/dev/null || die 'user systemd is unavailable; enable lingering'
  validate_quadlets
  validate_caddy "$ROOT/gateway" "$ROOT/gateway/caddy.example.env"
  printf 'Podman %s; configuration checks passed\n' "$(podman version --format '{{.Client.Version}}')"
}

command="${1:-help}"
case "$command" in
  help|-h|--help|list) ;;
  deploy|add|enable) require_commands podman systemctl install ;;
  update) require_commands podman systemctl ;;
  disable|remove|restart|status) require_commands systemctl ;;
  logs) require_commands journalctl ;;
  check) require_commands podman systemctl ;;
  *) usage; exit 1 ;;
esac

case "$command" in
  deploy)
    case "${2:-}" in
      gateway) deploy_gateway "${3:-production}" ;;
      app) deploy_app "${3:-}" ;;
      all) deploy_all "${3:-production}" ;;
      '') usage; exit 1 ;;
      *) [[ -z "${3:-}" ]] || die 'deploy NAME does not accept another argument'; deploy_app "$2" ;;
    esac ;;
  update) update "${2:-}" ;;
  add|enable) deploy_app "${2:-}" ;;
  restart) restart_target "${2:-}" ;;
  disable) disable "${2:-}" ;;
  remove) remove_app "${2:-}" ;;
  status) status "${2:-all}" ;;
  logs) logs "${2:-}" "${3:-}" ;;
  list) list_apps ;;
  check) check ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
