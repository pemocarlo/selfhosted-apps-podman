# Set APP_URL to the exact public URL users will use, without a trailing slash.
# Local gateway example: http://bookstack.localhost:8080
# Production example: https://bookstack.myhostname.com
APP_URL=http://bookstack.localhost:8080

# Generate a unique value before production use:
# openssl rand -base64 32
APP_KEY=CHANGE_ME_GENERATE_A_UNIQUE_APP_KEY

DB_HOST=bookstack-db:3306
DB_DATABASE=bookstack
DB_USERNAME=bookstack
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
