.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
.DS_Store
*.swp
.disabled

# Never commit runtime secrets. Keep only sanitized templates.
.env
*.env
!*.example.env

# Keep persistent directories, but do not commit live runtime state.
gateway/data/*
!gateway/data/.gitkeep
gateway/config/*
!gateway/config/.gitkeep
services/*/config/*
!services/*/config/.gitkeep
services/*/mysql/*
!services/*/mysql/.gitkeep
services/*/public-uploads/*
!services/*/public-uploads/.gitkeep
services/*/storage-uploads/*
!services/*/storage-uploads/.gitkeep
services/*/data/*
!services/*/data/.gitkeep
services/*/var/*
!services/*/var/.gitkeep
